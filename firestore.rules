rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation for User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'mobile', 'state', 'examPreparation', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && data.mobile is string && data.mobile.size() <= 20
        && data.state is string
        && data.examPreparation is string;
    }

    // Users Collection (indexed by Auth UID)
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (existing().isRegistered != true);
    }

    // Registration Collection (indexed by Auth UID)
    match /Registration/{userId} {
      allow get: if isOwner(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if false; // Strict requirement: Once registered, no details can be changed!
    }

    // Quiz Attempts Collection
    match /quiz_attempts/{attemptId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
